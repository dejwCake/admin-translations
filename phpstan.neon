includes:
	- phpstan-baseline.neon
	- ./vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    phpVersion: 80500
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    type_coverage:
        return: 75
        param: 75
        property: 75
        constant: 75

    tmpDir: .phpstan.cache

    paths:
        - ./config
        - ./database
        - ./lang
        - ./resources
        - ./routes
        - ./src
        - ./tests

    ignoreErrors:
        -
            # The admin_users auth provider falls back to the consumer's App\Models\User
            # (config/auth.providers.admin_users.php), which does not exist inside the package.
            identifier: class.notFound
            message: '#App\\Models\\User#'
            path: src/Http/Controllers/Admin/TranslationsController.php

    excludePaths:
        - ./tests/fixtures/*
